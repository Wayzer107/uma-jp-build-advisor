[Unit]
Description=Umamusume Build Advisor Secure MCP Tunnel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
Environment=HOME=/home/YOUR_LINUX_USER
EnvironmentFile=/etc/uma-build-advisor/tunnel.env
WorkingDirectory=/home/YOUR_LINUX_USER/Sources/uma
ExecStart=/usr/local/bin/tunnel-client run --profile uma-build-advisor
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
